# chanapp LLM 配置示例。复制为 chanapp/.env（不入库）后填写。
LLM_PROVIDER=deepseek
LLM_API_KEY=
# 缺省 deepseek-flash（2026-09-10 起）。2026-08-25 实测 deepseek-chat 别名转发到 deepseek-v4-flash。
# 当时 /models 在线 id：deepseek-v4-flash / deepseek-v4-pro / deepseek-v4-flash-vision-exp。
# v4-flash 为推理模型（响应含 reasoning_content）；v4-pro 更贵更慢，本场景无收益。
LLM_MODEL=deepseek-flash
# LLM 响应等待秒数，范围 1–120；较慢模型可设 120。
LLM_TIMEOUT_SECONDS=30

# 运行数据路径（可选，逐项优先于实例配置 instance_dir 的派生路径；规则见 engine/instance_paths.py）
# CHANAPP_CACHE_DIR=   缓存根：事实库（含计算审计）、显示缓存
# WATCHLIST_PATH=      个人自选（仓库 watchlist.json 只作种子，不回写）；设了它，查看记录与周期偏好默认与它同目录
# VIEW_LOG_PATH=       搜索查看记录
# ANALYSIS_CACHE_DIR=  AI 分析缓存

# K 线后台采集（自选股按交易时段增量取数、补历史、写事实库）：默认开，置 0 关闭（测试与离线演示用 0）
COLLECTOR_ENABLED=1
