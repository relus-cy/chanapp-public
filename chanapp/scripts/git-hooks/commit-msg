#!/bin/sh
# 提交信息闸门：首行须符合 Conventional Commits，即 `type(scope)!: 描述`，scope 与 ! 可省。
# 可用类型以 TYPES 为准；启用命令见 CONTRIBUTING.md。用零依赖 shell 而非 commitlint：
# 仓库不引入 Node 依赖，且 commitlint 默认的大小写、行长规则会误伤中文提交。
TYPES='feat|fix|docs|refactor|perf|test|build|ci|chore|style|revert'

# 标题取首个非注释、非空行（编辑器模板里的 # 注释由 git 在 hook 之后清理）
header=$(grep -v '^#' "$1" | grep -m1 -v '^[[:space:]]*$')

# 提交信息同样不得含凭据或个人信息（配置同 pre-commit）；未安装 gitleaks 时跳过
if command -v gitleaks >/dev/null 2>&1; then
  root=$(git rev-parse --show-toplevel)
  config=$(git config --get chanapp.gitleaksConfig)
  if [ -n "$config" ] && [ ! -f "$config" ]; then
    echo "提交被拒：chanapp.gitleaksConfig 指向的配置不存在：$config" >&2
    exit 1
  fi
  [ -n "$config" ] || config="$root/.gitleaks.toml"
  [ -f "$config" ] || config=  # 仓库没有配置文件时用 gitleaks 默认规则
  if ! gitleaks stdin --redact --no-banner --log-level warn ${config:+--config "$config"} < "$1" >/dev/null; then
    echo '提交被拒：提交信息含凭据或个人信息（gitleaks）' >&2
    exit 1
  fi
fi

# git 生成的合并、回滚与 fixup/squash/amend 信息放行
git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && exit 0
case "$header" in
  Merge*|'Revert "'*|'fixup! '*|'squash! '*|'amend! '*) exit 0 ;;
esac

printf '%s\n' "$header" | grep -Eq "^($TYPES)(\([^()]+\))?!?: [^ ]" && exit 0

cat >&2 <<EOF
提交被拒：信息不符合 Conventional Commits
  ${header:-（空）}
格式：type(scope): 描述（scope 可省；不兼容改动在冒号前加 !）
可用 type：$(printf '%s' "$TYPES" | tr '|' ' ')
混合改动取主类型（随改动同步的文档不单列 docs）；版本提交写 chore(release): vX.Y.Z
EOF
exit 1
